+import json
+from unittest.mock import AsyncMock, MagicMock
+
+import aiohttp
+import pytest
+
+import flocks.tool.web.websearch as websearch_module
+from flocks.tool.registry import ToolRegistry
+
+
+@pytest.fixture
+def mocked_exa(monkeypatch):
+    response = MagicMock(status=200)
+    response.text = AsyncMock(return_value=json.dumps({"results": []}))
+
+    response_context = MagicMock()
+    response_context.__aenter__ = AsyncMock(return_value=response)
+    response_context.__aexit__ = AsyncMock(return_value=None)
+
+    session = MagicMock()
+    session.post = MagicMock(return_value=response_context)
+    session.__aenter__ = AsyncMock(return_value=session)
+    session.__aexit__ = AsyncMock(return_value=None)
+
+    monkeypatch.setattr(aiohttp, "ClientSession", MagicMock(return_value=session))
+    monkeypatch.setattr(websearch_module, "_get_exa_api_key", lambda: "test-api-key")
+
+    ctx = MagicMock()
+    ctx.ask = AsyncMock()
+    return ctx, session
+
+
+def test_websearch_schema_exposes_current_and_legacy_types():
+    tool = ToolRegistry._tools["websearch"]
+    type_parameter = next(parameter for parameter in tool.info.parameters if parameter.name == "type")
+
+    assert type_parameter.enum == [
+        *websearch_module.EXA_SEARCH_TYPES,
+        *websearch_module.LEGACY_SEARCH_TYPE_MAP,
+    ]
+
+
+@pytest.mark.parametrize("search_type", websearch_module.EXA_SEARCH_TYPES)
+@pytest.mark.asyncio
+async def test_websearch_sends_current_exa_search_types_unchanged(mocked_exa, search_type):
+    ctx, session = mocked_exa
+
+    result = await websearch_module.websearch_tool(ctx, query="current contract", type=search_type)
+
+    request_body = session.post.call_args.kwargs["json"]
+    assert request_body["type"] == search_type
+    assert result.success is True
+    assert result.metadata["requested_type"] == search_type
+    assert result.metadata["effective_type"] == search_type
+
+
+@pytest.mark.parametrize("legacy_type", ["neural", "keyword"])
+@pytest.mark.asyncio
+async def test_websearch_maps_legacy_search_types_to_auto(mocked_exa, legacy_type):
+    ctx, session = mocked_exa
+
+    result = await websearch_module.websearch_tool(ctx, query="legacy contract", type=legacy_type)
+
+    request_body = session.post.call_args.kwargs["json"]
+    assert request_body["type"] == "auto"
+    assert result.success is True
+    assert result.metadata["requested_type"] == legacy_type
+    assert result.metadata["effective_type"] == "auto"
+
+
+@pytest.mark.parametrize(
+    ("requested", "expected"),
+    [
+        (1, 1),
+        (100, 100),
+        (101, 100),
+        (0, websearch_module.DEFAULT_NUM_RESULTS),
+        (-1, websearch_module.DEFAULT_NUM_RESULTS),
+        ("invalid", websearch_module.DEFAULT_NUM_RESULTS),
+    ],
+)
+@pytest.mark.asyncio
+async def test_websearch_keeps_num_results_within_exa_contract(mocked_exa, requested, expected):
+    ctx, session = mocked_exa
+
+    result = await websearch_module.websearch_tool(ctx, query="bounded results", numResults=requested)
+
+    request_body = session.post.call_args.kwargs["json"]
+    assert request_body["numResults"] == expected
+    assert result.success is True
+    assert result.metadata["num_results"] == expected

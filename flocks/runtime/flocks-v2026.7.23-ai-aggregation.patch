+        "flocks.workflow.center.list_registry_entries",
+        registry_entries,
+    )
+
+    loaded = _default_workflow_loader(str(workflow_path))
+
+    assert loaded.name == "Explicit Path"
+    registry_entries.assert_not_awaited()
+
+
+@pytest.mark.parametrize("identifier_field", ["name", "workflowId"])
+def test_default_workflow_loader_uses_registry_path_as_final_fallback(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    identifier_field: str,
+):
+    workflow_path = tmp_path / "registered-workflow.json"
+    workflow_path.write_text(
+        json.dumps(
+            {
+                "name": "Registry Workflow",
+                "start": "node",
+                "nodes": [{"id": "node", "type": "python", "code": "pass"}],
+                "edges": [],
+            }
+        ),
+        encoding="utf-8",
+    )
+    requested_id = f"registered-by-{identifier_field}"
+    monkeypatch.setattr(fs_store, "read_workflow_from_fs", lambda _workflow_id: None)
+    monkeypatch.setattr(
+        "flocks.storage.storage.Storage.read",
+        AsyncMock(return_value=None),
+    )
+    registry_entries = AsyncMock(
+        return_value=[
+            {
+                identifier_field: requested_id,
+                "workflowPath": str(workflow_path),
+            }
+        ]
+    )
+    monkeypatch.setattr(
+        "flocks.workflow.center.list_registry_entries",
+        registry_entries,
+    )
+
+    loaded = _default_workflow_loader(requested_id)
+
+    assert loaded.name == "Registry Workflow"
+    registry_entries.assert_awaited_once_with()
+

+from __future__ import annotations
+
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+
+from flocks.tool import ToolContext
+import flocks.tool.task.run_workflow as run_workflow_module
+from flocks.tool.task.run_workflow import _validate_workflow_inputs
+
+
+@pytest.mark.parametrize(
+    ("workflow_id", "workflow_name"),
+    [
+        ("threat_intel_search_pipeline", "Threat Intel Search"),
+        ("other-id", "threat_intel_search_pipeline"),
+        (r"C:\workflows\THREAT_INTEL_SEARCH_PIPELINE\workflow.json", "Threat Intel Search"),
+    ],
+)
+def test_threat_intel_workflow_requires_query_input(workflow_id, workflow_name):
+    error = _validate_workflow_inputs(
+        workflow_id,
+        workflow_name,
+        {},
+    )
+
+    assert error is not None
+    assert "inputs.query" in error
+
+
+@pytest.mark.parametrize(
+    "inputs",
+    [
+        {"query": "recent energy ransomware incidents"},
+        {"target": "example.com"},
+        {"text": "APT activity"},
+    ],
+)
+def test_threat_intel_workflow_accepts_supported_query_input(inputs):
+    error = _validate_workflow_inputs(
+        "threat_intel_search_pipeline",
+        "threat_intel_search_pipeline",
+        inputs,
+    )
+
+    assert error is None
+
+
+def test_threat_intel_workflow_rejects_blank_query_input():
+    error = _validate_workflow_inputs(
+        "threat_intel_search_pipeline",
+        "threat_intel_search_pipeline",
+        {"query": " \t"},
+    )
+
+    assert error is not None
+
+
+def test_unrelated_workflow_does_not_require_query_input():
+    error = _validate_workflow_inputs("other_workflow", "other_workflow", {})
+
+    assert error is None
+
+
+@pytest.mark.anyio
+async def test_registered_threat_intel_workflow_is_validated_before_execution(monkeypatch):
+    runtime = Mock(name="run_workflow")
+    registered_workflow = {
+        "name": "Threat Intel Search",
+        "start": "search",
+        "nodes": [{"id": "search", "type": "python", "code": "outputs['ok'] = True"}],
+        "edges": [],
+    }
+    read_registered = Mock(
+        return_value={
+            "id": "threat_intel_search_pipeline",
+            "workflowJson": registered_workflow,
+        }
+    )
+    monkeypatch.setattr(run_workflow_module, "_build_description", AsyncMock(return_value="Run workflow"))
+    monkeypatch.setattr(
+        run_workflow_module,
+        "_get_workflow_runtime",
+        Mock(return_value=(Mock(name="RequirementsInstaller"), runtime, Mock(name="RunWorkflowResult"))),
+    )
+    monkeypatch.setattr(run_workflow_module, "read_workflow_from_fs", read_registered)
+
+    result = await run_workflow_module.run_workflow_tool(
+        ctx=ToolContext(
+            session_id="test-session",
+            message_id="test-message",
+            agent="test",
+        ),
+        workflow="threat_intel_search_pipeline",
+        inputs={},
+    )
+
+    assert result.success is False
+    assert "inputs.query" in result.error
+    read_registered.assert_called_once_with("threat_intel_search_pipeline")
+    runtime.assert_not_called()

# Copy to .env and configure credentials locally. Never commit .env.
DARKWEB_BASIC_AUTH_ENABLED=0
DARKWEB_BASIC_AUTH_USERNAME=
DARKWEB_BASIC_AUTH_PASSWORD=

# Reconnect external services using your own local credentials.
RANSOMWARE_LIVE_API_KEY=
GITEE_ACCESS_TOKEN=

# The captured deployment uses local Tor Browser and Flocks services.
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9150
DARKWEB_AI_AGGREGATION_MODE=live
DARKWEB_AI_AGGREGATION_DELIVERY_MODE=mock
DARKWEB_AI_AGGREGATION_WORKFLOW_ID=threat_intel_search_pipeline
FLOCKS_BASE_URL=http://127.0.0.1:5175
# Set FLOCKS_SECRET_FILE and FLOCKS_API_TOKEN_SECRET_ID locally as needed.
